    "./tools": "./lib/tools.js",
    "./lifecycle": "./lib/lifecycle.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "bin": { "feiyu-memory": "./scripts/cli.js" },
  "files": ["lib", "scripts", "test", "data/dict", "docs", "examples", "README.md", "CHANGELOG.md", "cordis.patch.yml"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-renderer"] }
  },
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.js",
    "benchmark": "node scripts/benchmark.js"
